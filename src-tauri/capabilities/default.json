{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Companion window permissions, including the app commands it calls",
  "windows": ["companion"],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "dialog:allow-open",
    "allow-inspect",
    "allow-start-jobs",
    "allow-cancel-job",
    "allow-retry-job",
    "allow-list-jobs",
    "allow-remove-job",
    "allow-engines-list",
    "allow-engine-install",
    "allow-engine-remove",
    "allow-engine-verify",
    "allow-get-settings",
    "allow-set-settings",
    "allow-reveal-job",
    "allow-open-job",
    "allow-notice-text",
    "allow-notices",
    "allow-thumbnail",
    "allow-highlight-handle"
  ]
}
